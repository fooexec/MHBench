FROM node:18-alpine@sha256:8d6421d663b4c28fd3ebc498332f249011d118945588d0a35cb9bc4b8ca09d9e AS frontend-build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
COPY upstream/client/package.json upstream/client/pnpm-lock.yaml ./
ARG NPM_REGISTRY=https://registry.npmjs.org
RUN pnpm config set registry "${NPM_REGISTRY}" \
    && pnpm install --frozen-lockfile
COPY upstream/client/ ./
RUN pnpm run build

FROM nginx:alpine@sha256:0563c36f94a6d3ec3584161b77859f740f7e20b4853f52c796a864ce6908e8ea
RUN rm /etc/nginx/conf.d/default.conf
COPY upstream/client/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=frontend-build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
